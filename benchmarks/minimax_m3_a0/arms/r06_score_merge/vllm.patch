+
+import os
+
+from .score_dispatch import score_decode
+
+SELECTED_CAP = 432
+
+
+def dispatch(
+    q_idx,
+    key_cache_idx,
+    score,
+    block_table,
+    seq_lens,
+    init_blocks=0,
+    local_blocks=0,
+    query_len=1,
+    max_seq_len=0,
+):
