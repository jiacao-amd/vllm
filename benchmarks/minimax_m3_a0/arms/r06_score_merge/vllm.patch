+        return score_decode(
+            q_idx,
+            key_cache_idx,
+            score,
+            block_table,
+            seq_lens,
+            init_blocks,
+            local_blocks,
+            query_len,
+            max_seq_len,
+            cap=SELECTED_CAP,
+        )
+    from aiter.ops.msa_block_select import pa_sparse_block_score_decode
+
+    return pa_sparse_block_score_decode(
+        q_idx,
+        key_cache_idx,
+        score,
+        block_table,
+        seq_lens,
+        init_blocks,
+        local_blocks,
+        query_len,
+        max_seq_len,
+    )
